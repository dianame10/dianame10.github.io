---
import { ClientRouter } from 'astro:transitions';
import { site, socials } from '../data/site';
import Printer from '../components/Printer.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props { title?: string; description?: string; image?: string; jsonLd?: Record<string, unknown> }
const { title, description = site.description, image = '/og.png', jsonLd: extraLd } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role.toLowerCase()} in Wellington`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Wellington', addressCountry: 'NZ' },
  worksFor: { '@type': 'Organization', name: 'Xero' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Canterbury' },
  sameAs: socials.map((s) => s.href),
};
---
<!doctype html>
<html lang="en-NZ" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#3b7cd1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {extraLd && <script type="application/ld+json" set:html={JSON.stringify(extraLd)} />}
    <link rel="preload" href="/fonts/archivo-100_900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true">
      <div class="curtain__panel">
        <span class="label" data-curtain-kicker>Printing</span>
        <span class="curtain__title display" data-curtain-title></span>
      </div>
    </div>
    <Printer />
    <main id="main" tabindex="-1">
      <div class="feed" data-feed>
        <slot />
      </div>
    </main>
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
