---
import Base from '../layouts/Base.astro';
import Finale from '../components/Finale.astro';
import Portrait from '../components/Portrait.astro';
import { site, projects, xero, totals, approach } from '../data/site';
---
<Base>
  <section class="field--cobalt hero">
    <div class="wrap">
      <div class="hero__grid">
        <p class="hero__meta label">
          <span>{site.location}</span>
        </p>
        <p class="hero__intro lead">{site.statement}</p>
        <h1 class="hero__name display"><span>{site.first}</span><span>{site.last}</span></h1>
        <span class="hero__ghost display outline" aria-hidden="true">Engineer</span>
        <div class="hero__portrait"><Portrait eager /></div>
      </div>
      <div class="hero__role">
        <p class="label label--s">{site.role} · Xero · Wellington</p>
        <a class="btn btn--mustard" href="#work">See the work <span class="btn__arrow" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section id="work" class="field field--tomato" aria-labelledby="work-h">
    <div class="wrap">
      <div class="grid work-head">
        <h2 id="work-h" class="display">The work</h2>
        <p class="label label--s">Three things I built, all real and all still running</p>
      </div>
      <ul class="cards">
        {projects.map((p, i) => (
          <li>
            <a class={`card card--${p.colour}`} href={`/work/${p.slug}/`} data-title={p.short}>
              <span class="card__top label"><span>Project 0{i + 1}</span><span>{p.tag}</span></span>
              <span class="card__title display">{p.short}</span>
              <span class="card__panel">
                <span class="card__value display">{p.stat.value}</span>
                <span class="label">{p.stat.label}</span>
              </span>
              <span class="card__summary">{p.summary}</span>
              <span class="card__foot label"><span>See what I built</span><span class="card__arrow" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="field field--ultra approach" aria-labelledby="approach-h">
    <div class="wrap grid">
      <p class="approach__label label">How I build</p>
      <h2 id="approach-h" class="approach__heading display">{approach.heading}</h2>
      <div class="approach__body lead">{approach.body.map((b) => <p>{b}</p>)}</div>
    </div>
  </section>

  <section class="field field--pink" aria-labelledby="xero-h">
    <div class="wrap grid">
      <div class="xero__text">
        <p class="label">Current role · {xero.team}</p>
        <h2 id="xero-h" class="xero__name display">Xero</h2>
        <p class="prose">{xero.blurb}</p>
        <p style="margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem">
          <a class="link" href="/work/xero-bank-reconciliation/" data-title="Bank reconciliation, Xero">Read what I work on there</a>
          <a class="link" href="/about/" data-title="About">More about me</a>
        </p>
      </div>
      <ol class="xero__lines lines" aria-label="Roles at Xero">
        {xero.roles.map((r) => (
          <li class="line"><span class="line__label">{r.label}</span><span class="line__dots" aria-hidden="true"></span><span class="line__value label label--s">{r.value}</span></li>
        ))}
        <li class="line"><span class="line__label">Stack</span><span class="line__dots" aria-hidden="true"></span><span class="line__value label label--s">{xero.stack}</span></li>
      </ol>
    </div>
  </section>

  <section class="field field--ink" aria-labelledby="totals-h">
    <div class="wrap">
      <div class="totals__head">
        <h2 id="totals-h" class="display">Totals</h2>
        <span class="label">Real numbers only</span>
      </div>
      <ul class="totals__grid">
        {totals.map((t) => (
          <li><span class="total__value display">{t.value}</span><span class="total__label">{t.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <Finale />
</Base>
